# Use either DATABASE_URL or SUPABASE_DB_URL for the server-side Postgres connection.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aman_dman
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=15000
NODE_ENV=development
APP_URL=http://localhost:3000
GITHUB_TOKEN=
AUTH_SECRET=replace-with-a-long-random-secret
VATSIM_CONNECT_BASE_URL=https://auth-dev.vatsim.net
VATSIM_CONNECT_CLIENT_ID=
VATSIM_CONNECT_CLIENT_SECRET=
# Optional comma-separated admin allowlist. Leave empty to allow any authenticated VATSIM user.
VATSIM_ADMIN_CIDS=
# Optional openAIP tiles support for the horizon editor map.
# The API key stays on the server; the browser only hits our internal tile proxy route.
OPENAIP_API_KEY=
# Backward-compatible alias if you already set it earlier:
# OPENAIP_TILES_CLIENT_ID=
NEXT_PUBLIC_OPENAIP_TILES_ENABLED=false
